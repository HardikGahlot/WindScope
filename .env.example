# WindScope Environment Configuration Example
PROJECT_NAME="WindScope — UK Wind Forecast Intelligence"
API_V1_STR="/api"

# Elexon BMRS API Upstream Host
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
HTTP_TIMEOUT_SECONDS=25.0
HTTP_MAX_RETRIES=3

# Market and Decision Defaults
DEFAULT_CUTOFF_TIME="09:30"
DEFAULT_TIMEZONE="Europe/London"

# Local Data Cache
CACHE_ENABLED=true
CACHE_DIR="data/cache"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://*.vercel.app"

# Frontend Public API URL (Set in frontend Vercel deployment)
# VITE_API_URL="https://windscope-backend.onrender.com"
